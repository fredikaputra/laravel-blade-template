includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - phpstan/canvural.neon
    - phpstan/ergebnis.neon
    - phpstan/larastan.neon
    - phpstan/nesbot.neon
    - phpstan/pestphp.neon
    - phpstan/shipmonk.neon
    - phpstan/tomasvotruba.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max

    excludePaths:
        - public/frankenphp-worker.php (?)

    ignoreErrors:
        -
            path: resources/views/mcp/*
            identifier: larastan.unusedViews
            reportUnmatched: true

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - public
        - routes
        - tests

    checkBenevolentUnionTypes: true
    checkMissingCallableSignature: true
    checkMissingOverrideMethodAttribute: true
    checkMissingOverridePropertyAttribute: true
    checkTooWideParameterOutInProtectedAndPublicMethods: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkTooWideThrowTypesInProtectedAndPublicMethods: true
    checkUninitializedProperties: true
    phpVersion: 80500
    rememberPossiblyImpureFunctionValues: false
    reportAlwaysTrueInLastCondition: true
    reportAnyTypeWideningInVarTag: true
    reportIgnoresWithoutComments: true
    reportPossiblyNonexistentConstantArrayOffset: true
    reportPossiblyNonexistentGeneralArrayOffset: true
    reportUnsafeArrayStringKeyCasting: prevent
    resultCacheChecksProjectExtensionFilesDependencies: true
    usePathConstantsAsConstantString: true

    universalObjectCratesClasses!: []

    exceptions:
        implicitThrows: false
        check:
            missingCheckedExceptionInThrows: true
            throwTypeCovariance: true
            tooWideImplicitThrowType: true

    featureToggles:
        reportNestedTooWideType: true

    phpunit:
        reportMissingDataProviderReturnType: true
