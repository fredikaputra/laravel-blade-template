{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nunomaduro/laravel-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5.0",
        "laravel/fortify": "^1.40",
        "laravel/framework": "^13.33",
        "laravel/mcp": "^1.0.1",
        "laravel/nightwatch": "^1.30.2",
        "laravel/octane": "^2.20.0",
        "laravel/passport": "^13.8",
        "laravel/reverb": "^1.12.0",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "nunomaduro/essentials": "^1.2"
    },
    "require-dev": {
        "canvural/larastan-strict-rules": "^3.0.4",
        "driftingly/rector-laravel": "^2.6.2",
        "ergebnis/phpstan-rules": "^2.14.0",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.12.2",
        "laravel/boost": "^2.10.0",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "laravel/pulse": "^1.8.1",
        "laravel/sail": "^1.68",
        "laravel/tinker": "^3.0.2",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.2.1",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-phpstan": "^5.2.1",
        "pestphp/pest-plugin-rector": "^5.0.4",
        "pestphp/pest-plugin-stressless": "^5.0.2",
        "pestphp/pest-plugin-type-coverage": "^5.0.2",
        "phpstan/phpstan": "^2.2.16",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-phpunit": "^2.0.19",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "rector/rector": "^2.6.7",
        "roave/security-advisories": "dev-latest",
        "shipmonk/phpstan-rules": "^4.4",
        "tomasvotruba/cognitive-complexity": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear",
            "@update:requirements"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "update:requirements": [
            "composer bump"
        ],
        "lint": [
            "rector",
            "pint --parallel"
        ],
        "test": [
            "@test:composer",
            "@test:lint",
            "@test:types",
            "@test:unit"
        ],
        "test:composer": [
            "composer audit --abandoned=fail",
            "composer validate --strict",
            "composer outdated --strict --ignore=brick/math --ignore=guzzlehttp/* --ignore=phpunit/phpunit --ignore=symplify/*",
            "composer-unused --excludePackage=laravel/nightwatch --excludePackage=laravel/octane --excludePackage=laravel/reverb --excludePackage=nunomaduro/essentials"
        ],
        "test:lint": [
            "pest --profanity",
            "pint --parallel --test --bail",
            "yaml-lint compose.yaml .github/"
        ],
        "test:mutate": "pest --mutate --everything --parallel --min=100 --bail",
        "test:stress": "pest tests/Stress",
        "test:types": [
            "pest --type-coverage --min=100",
            "phpstan",
            "rector --dry-run"
        ],
        "test:unit": "pest --parallel --coverage --exactly=100.0"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
